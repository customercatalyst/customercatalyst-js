{
  // Always deploy with --env test or --env production. The top level only exists
  // because wrangler requires it: a bare `wrangler deploy` makes a stray, unrouted
  // Worker instead of overwriting a real one.
  "name": "customercatalyst-messenger-local",
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",
  "account_id": "21649d75dfaa2b2797d371a308d5f078",
  "workers_dev": false,
  "preview_urls": false,
  // The widgets are served from here, but only through the Worker (/v1/form.js, /v1/messenger.js,
  // each bundled with shared/kit.js): run_worker_first keeps every file unreachable by its own path.
  "assets": { "directory": "../widgets", "binding": "ASSETS", "run_worker_first": true },
  // Invocation logs record each request URL, and /s/<token> carries a live survey token: off. Our own
  // console.log lines (PII-free) are kept.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },

  "env": {
    "test": {
      "name": "customercatalyst-messenger-test",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "test",
        "SUPABASE_FUNCTION_URL": "https://tqrwkscxilrwnbwlrkpa.supabase.co/functions/v1/messenger",
        // NPS survey pages (/s/<token>); secret SURVEYS_WORKER_SECRET.
        "SURVEYS_FUNCTION_URL": "https://tqrwkscxilrwnbwlrkpa.supabase.co/functions/v1/surveys",
        "TURNSTILE_SITEKEY": "0x4AAAAAAFr0NFpzRiNihaXe",
        "HOSTED_HOST": "",
        // "managed" (visible widget) | "invisible". Invisible also needs the sitekey switched:
        // wrangler turnstile widget update <sitekey> --mode invisible (see README).
        "TURNSTILE_MODE": "managed",
        "PRIVACY_URL": "",
        // Settings pages (Bubble) that may frame /v1/preview and /v1/messenger/preview, and the only
        // origins whose preview messages the widgets accept. Space-separated https origins.
        "PREVIEW_PARENT_ORIGINS": "https://app.customercatalyst.io https://customer-catalyst-15453.bubbleapps.io"
      },
      // Limits count per Cloudflare location, per key (docs: rate-limit binding).
      "ratelimits": [
        { "name": "RL_CONFIG_IP", "namespace_id": "6101", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_SUBMIT_IP", "namespace_id": "6102", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_SUBMIT_KEY", "namespace_id": "6103", "simple": { "limit": 30, "period": 60 } },
        // Phase 2 conversations: list/thread polls + file downloads (thread polls 6/min), and replies.
        { "name": "RL_READ_IP", "namespace_id": "6104", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_REPLY_IP", "namespace_id": "6105", "simple": { "limit": 20, "period": 60 } },
        // The list fans out to several reads: its own per-IP limit. Per key (all of a site's visitors):
        // list + thread + file, and replies.
        { "name": "RL_LIST_IP", "namespace_id": "6106", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_READ_KEY", "namespace_id": "6107", "simple": { "limit": 1200, "period": 60 } },
        { "name": "RL_REPLY_KEY", "namespace_id": "6108", "simple": { "limit": 60, "period": 60 } },
        // NPS survey pages: page loads + answers + unsubscribes per IP, and per recipient token.
        { "name": "RL_SURVEY_IP", "namespace_id": "6109", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_SURVEY_TOKEN", "namespace_id": "6110", "simple": { "limit": 20, "period": 60 } }
      ]
    },
    // Configured, NOT deployed (LIVE cutover: docs/scopes/messenger-live-cutover.md in
    // customercatalyst-dev). Set TURNSTILE_SITEKEY to the live widget's key first.
    "production": {
      "name": "customercatalyst-messenger",
      "workers_dev": false,
      "preview_urls": false,
      // No routes: customercatalyst.io DNS is not on Cloudflare. widget.customercatalyst.io is a Pages
      // project (CNAME at the DNS host, like mcp.) whose _worker.js forwards to this Worker through a
      // service binding. See messenger-live-cutover.md in customercatalyst-dev, step 8a.
      "vars": {
        "ENVIRONMENT": "production",
        "SUPABASE_FUNCTION_URL": "https://xfjgmzwigomtfmaloeun.supabase.co/functions/v1/messenger",
        // NPS survey pages (/s/<token>); secret SURVEYS_WORKER_SECRET.
        "SURVEYS_FUNCTION_URL": "https://xfjgmzwigomtfmaloeun.supabase.co/functions/v1/surveys",
        "TURNSTILE_SITEKEY": "",
        "HOSTED_HOST": "",
        "TURNSTILE_MODE": "managed",
        "PRIVACY_URL": "",
        // Settings pages (Bubble) that may frame /v1/preview and /v1/messenger/preview, and the only
        // origins whose preview messages the widgets accept. Space-separated https origins.
        "PREVIEW_PARENT_ORIGINS": "https://app.customercatalyst.io https://customer-catalyst-15453.bubbleapps.io"
      },
      "ratelimits": [
        { "name": "RL_CONFIG_IP", "namespace_id": "6201", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_SUBMIT_IP", "namespace_id": "6202", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_SUBMIT_KEY", "namespace_id": "6203", "simple": { "limit": 30, "period": 60 } },
        // Phase 2 conversations: list/thread polls + file downloads (thread polls 6/min), and replies.
        { "name": "RL_READ_IP", "namespace_id": "6204", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_REPLY_IP", "namespace_id": "6205", "simple": { "limit": 20, "period": 60 } },
        // The list fans out to several reads: its own per-IP limit. Per key (all of a site's visitors):
        // list + thread + file, and replies.
        { "name": "RL_LIST_IP", "namespace_id": "6206", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_READ_KEY", "namespace_id": "6207", "simple": { "limit": 1200, "period": 60 } },
        { "name": "RL_REPLY_KEY", "namespace_id": "6208", "simple": { "limit": 60, "period": 60 } },
        // NPS survey pages: page loads + answers + unsubscribes per IP, and per recipient token.
        { "name": "RL_SURVEY_IP", "namespace_id": "6209", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_SURVEY_TOKEN", "namespace_id": "6210", "simple": { "limit": 20, "period": 60 } }
      ]
    }
  }
}
