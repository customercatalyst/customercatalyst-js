{
  // Assets-only Worker: it serves the SDK file and nothing else, so there is no
  // "main" entrypoint. The build step copies the SDK into ./dist so that only
  // that one file is published — the README and config stay out of the CDN.
  "name": "customercatalyst-js",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./dist"
  }
}
